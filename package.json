{
  "name": "@mastermind/enigma",
  "private": true,
  "type": "module",
  "bin": {
    "enigma": "./cli/commands/run.ts",
    "enigma-ssrf": "./cli/commands/ssrf/index.ts",
    "enigma-payloads": "./cli/commands/payloads.ts"
  },
  "scripts": {
    "run": "node --experimental-strip-types ./cli/commands/run.ts",
    "payloads": "node --experimental-strip-types ./cli/commands/payloads.ts",
    "init": "node --experimental-strip-types ./cli/commands/init.ts",
    "next": "node --experimental-strip-types ./cli/commands/next.ts",
    "observe": "node --experimental-strip-types ./cli/commands/observe.ts",
    "discover": "node --experimental-strip-types ./cli/commands/discover/index.ts",
    "result": "node --experimental-strip-types ./cli/commands/result.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test ./tests/**/*.test.ts"
  },
  "dependencies": {
    "playwright": "^1.58.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.8.2"
  }
}
